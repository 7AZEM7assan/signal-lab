# Copy to .env to override defaults used by docker-compose.yml. Every value below
# is a safe local-demo default; none of these are real secrets. Do not reuse them anywhere public.

# Host port for the NGINX front door (bound to 127.0.0.1 only).
SIGNALLAB_PORT=8088

# PostgreSQL (internal to the compose network; not published to the host).
POSTGRES_USER=signallab
POSTGRES_PASSWORD=signallab
POSTGRES_DB=signallab

# Service tuning (see README "Configuration" for the full list).
SIGNALLAB_QUEUE_CAPACITY=1000
SIGNALLAB_WORKERS=4
SIGNALLAB_TEMP_ALERT_C=85
SIGNALLAB_VIB_ALERT_MM_S=7.1
SIGNALLAB_LOG_LEVEL=info

# Lab-only overload knob: artificial delay per worker batch. Leave 0 normally.
SIGNALLAB_LAB_WORKER_DELAY=0s
