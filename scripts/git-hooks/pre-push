#!/usr/bin/env bash
# Runs the fast local CI checks before a push that touches this project.
#
# Install (opt-in):   make install-hooks
# Skip once:          SKIP_CI=1 git push     (or: git push --no-verify)
#
# Pushes that do not change files under this project (e.g. other content in the same
# repository) are not checked.
[ -n "${SKIP_CI:-}" ] && exit 0

project="$(cd "$(dirname "$0")/../.." && pwd)"
top="$(git rev-parse --show-toplevel)"
prefix=""
[ "$project" != "$top" ] && prefix="${project#"$top"/}"
zero=0000000000000000000000000000000000000000

touches_project=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref: nothing to check
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    touches_project=1 # new branch, or remote history not available locally: be safe and check
  elif [ -n "$(git diff --name-only "$remote_sha" "$local_sha" -- "${prefix:-.}")" ]; then
    touches_project=1
  fi
done

[ "$touches_project" = 0 ] && exit 0

echo "pre-push: running 'make ci-fast' (skip with SKIP_CI=1 or --no-verify)"
if ! make -C "$project" ci-fast; then
  echo "pre-push: checks failed; push aborted." >&2
  exit 1
fi
